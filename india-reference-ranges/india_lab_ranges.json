  "meta": {
    "name": "Metangy India Lab Reference Ranges",
    "version": "0.1.0",
    "country": "IN",
    "updated": "2026-11-10",
    "license": "CC-BY-4.0",
    "warning": "These are typical adult ranges, not a diagnosis. The reference interval printed on the patient's own report always wins, because it comes from the assay that produced the number.",
    "why_lab_overrides_exist": "Indian labs run different assay platforms (Roche Cobas, Beckman Access, Siemens Centaur, Abbott Architect), so their reference intervals genuinely differ. TSH is the clearest case: the same value can be flagged high at Thyrocare and normal at Metropolis.",
    "sources": [
      "Published Indian laboratory reference charts and sample reports",
      "Thyrocare, Dr Lal PathLabs, SRL and Metropolis TSH intervals as published",
      "ADA thresholds for HbA1c classification"
    ]
  },
